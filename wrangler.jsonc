{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "project-management",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    // Enable Node.js API (required by @opennextjs/cloudflare and Prisma)
    "nodejs_compat",
    // Allow fetch() to public URLs only
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "project-management"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pm-database",
      "database_id": "34de392b-b365-4dfe-b685-909bf9bab732"
    }
  ]
}
